// Ozel Egitim Kurumu Takip ve Raporlama Sistemi - Prisma semasi

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  MUDUR
  OGRETMEN
  VELI
}

enum AttendanceStatus {
  VAR
  YOK
  GEC
  IZINLI
}

enum HedefKategori {
  ILETISIM
  OZ_BAKIM
  AKADEMIK
  SOSYAL
  MOTOR
  DAVRANIS
}

enum HedefDurum {
  AKTIF
  TAMAMLANDI
  ERTELENDI
}

// MEB BEP formlarindaki standart basari duzeyi olcegi
enum BasariSeviyesi {
  BAGIMSIZ
  SOZEL_IPUCUYLA
  FIZIKSEL_YARDIMLA
  YAPAMADI
}

enum BildirimTuru {
  VELI_NOTU
  HEDEF_OLUSTURULDU
  HEDEF_TAMAMLANDI
  OGRENCI_ATANDI
  GUVENLIK_UYARISI
  YENI_MESAJ
}

model Institution {
  id        String   @id @default(cuid())
  ad        String
  adres     String?
  telefon   String?
  email     String?
  aktifMi   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  classrooms Classroom[]
  students   Student[]

  @@map("institutions")
}

model User {
  id          String    @id @default(cuid())
  adSoyad     String
  email       String    @unique
  sifreHash   String
  rol         Role
  aktifMi     Boolean   @default(true)
  // Profil fotografi: istemcide 256x256 JPEG'e kucultulup data URL olarak saklanir.
  // avatarSurum, fotografin varligini ve surumunu tutar; listeleme sorgulari
  // 20KB'lik base64'u cekmeden sadece bu alani okuyup <img> src'sini kurabilir.
  avatar      String?
  avatarSurum DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)

  // ogretmen ise verdigi siniflar
  classroomsTaught Classroom[]  @relation("ClassroomTeacher")
  sessionLogs      SessionLog[] @relation("TeacherSessionLogs")

  // veli ise cocuklari
  children Student[] @relation("StudentParent")

  auditLogs AuditLog[]

  attendanceRecordsCreated Attendance[] @relation("AttendanceRecorder")

  hedeflerOlusturulan Hedef[]         @relation("HedefOlusturan")
  ilerlemeKayitlari   HedefIlerleme[] @relation("IlerlemeEkleyen")
  veliNotlariYazilan  ParentNote[]    @relation("VeliNotuYazari")

  bildirimler        Notification[]
  programYuklenenler ScheduleSlot[]    @relation("ScheduleSlotOgretmen")
  belgelerYuklenen   StudentDocument[] @relation("BelgeYukleyen")
  mesajlarGonderilen Message[]         @relation("MesajGonderen")

  @@index([institutionId])
  @@map("users")
}

model Classroom {
  id String @id @default(cuid())
  ad String

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  teacherId String?
  teacher   User?   @relation("ClassroomTeacher", fields: [teacherId], references: [id], onDelete: SetNull)

  students Student[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([institutionId])
  @@map("classrooms")
}

model Student {
  id                String    @id @default(cuid())
  adSoyad           String
  dogumTarihi       DateTime?
  taniKategorisi    String?
  kayitTarihi       DateTime  @default(now())
  aktifMi           Boolean   @default(true)
  // Saglik/acil durum bilgisi - ogretmen/mudur/veli tarafindan girilir,
  // ogrenci profilinde one cikan bir kart olarak gosterilir.
  allerjiler        String?
  kullandigiIlaclar String?
  saglikNotu        String?
  acilKontakAdi     String?
  acilKontakTelefon String?
  // Profil fotografi: ogretmen/mudur/admin tarafindan yuklenir.
  avatar            String?
  avatarSurum       DateTime?

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  classroomId String?
  classroom   Classroom? @relation(fields: [classroomId], references: [id], onDelete: SetNull)

  veliId String?
  veli   User?   @relation("StudentParent", fields: [veliId], references: [id], onDelete: SetNull)

  sessionLogs       SessionLog[]
  attendanceRecords Attendance[]
  hedefler          Hedef[]
  veliNotlari       ParentNote[]
  programSlotlari   ScheduleSlot[]
  belgeler          StudentDocument[]
  mesajlar          Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([institutionId])
  @@index([classroomId])
  @@index([veliId])
  @@map("students")
}

// Gunluk devam/devamsizlik kaydi - ogretmen tarafindan sinif icin girilir
model Attendance {
  id       String           @id @default(cuid())
  tarih    DateTime // gun bazinda (saat kismi 00:00'a normallestirilir)
  durum    AttendanceStatus
  aciklama String?

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  recordedById String
  recordedBy   User   @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, tarih])
  @@index([studentId])
  @@index([tarih])
  @@map("attendance_records")
}

// Bireysellestirilmis Egitim Programi (BEP) hedefi
model Hedef {
  id               String        @id @default(cuid())
  baslik           String
  aciklama         String?
  kategori         HedefKategori
  durum            HedefDurum    @default(AKTIF)
  hedefTarihi      DateTime?
  tamamlanmaTarihi DateTime?

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  olusturanId String
  olusturan   User   @relation("HedefOlusturan", fields: [olusturanId], references: [id], onDelete: Cascade)

  ilerlemeKayitlari HedefIlerleme[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([durum])
  @@map("hedefler")
}

// Bir hedefe dogru tek bir ilerleme/degerlendirme kaydi
model HedefIlerleme {
  id     String         @id @default(cuid())
  tarih  DateTime       @default(now())
  seviye BasariSeviyesi
  notu   String?

  hedefId String
  hedef   Hedef  @relation(fields: [hedefId], references: [id], onDelete: Cascade)

  ekleyenId String
  ekleyen   User   @relation("IlerlemeEkleyen", fields: [ekleyenId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([hedefId])
  @@index([tarih])
  @@map("hedef_ilerleme_kayitlari")
}

// Ogretmen/mudurden veliye tek yonlu, hizli bilgilendirme notu
model ParentNote {
  id     String  @id @default(cuid())
  icerik String
  onemli Boolean @default(false)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  yazarId String
  yazar   User   @relation("VeliNotuYazari", fields: [yazarId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([studentId])
  @@index([createdAt])
  @@map("parent_notes")
}

// Veli <-> ogretmen/mudur arasinda ogrenci baglaminda iki yonlu mesajlasma
model Message {
  id     String @id @default(cuid())
  icerik String

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  gonderenId String
  gonderen   User   @relation("MesajGonderen", fields: [gonderenId], references: [id], onDelete: Cascade)

  // Karsi tarafin (gonderen olmayan taraf) mesaji acip okuyup okumadigi
  okunduMu Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([studentId, createdAt])
  @@map("messages")
}

// Uygulama ici bildirim - zil menusunde gosterilir
model Notification {
  id       String       @id @default(cuid())
  tur      BildirimTuru
  baslik   String
  mesaj    String
  link     String? // tiklaninca gidilecek yol, ornek: "/veli/ogrenci/xyz"
  okunduMu Boolean      @default(false)

  aliciId String
  alici   User   @relation(fields: [aliciId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([aliciId, okunduMu])
  @@index([createdAt])
  @@map("notifications")
}

// Haftalik tekrar eden ders programi sablonu (belirli bir tarih degil, haftanin gunu)
model ScheduleSlot {
  id             String @id @default(cuid())
  // 1=Pazartesi ... 5=Cuma
  gun            Int
  baslangicSaati String // "09:00" bicimi, siralama/karsilastirma icin string yeterli
  bitisSaati     String

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  teacherId String
  teacher   User   @relation("ScheduleSlotOgretmen", fields: [teacherId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([teacherId, gun])
  @@index([studentId])
  @@map("schedule_slots")
}

// Ogrenciye ait belge (resmi BEP formu, doktor raporu, degerlendirme evraki vb.)
model StudentDocument {
  id        String  @id @default(cuid())
  dosyaAdi  String
  mimeTuru  String
  boyutBayt Int
  veri      String // data URL olarak saklanir (avatar ile ayni desen)
  aciklama  String?

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  yukleyenId String
  yukleyen   User   @relation("BelgeYukleyen", fields: [yukleyenId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([studentId])
  @@map("student_documents")
}

model BehaviorTag {
  id       String  @id @default(cuid())
  ad       String  @unique
  kategori String?
  renkKodu String  @default("#94A3B8")

  sessionLogs SessionLogBehaviorTag[]

  @@map("behavior_tags")
}

model SessionLog {
  id              String   @id @default(cuid())
  tarih           DateTime @default(now())
  islenenKonu     String?
  verimlilikPuani Int // 1-10
  serbestNot      String?

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  teacherId String
  teacher   User   @relation("TeacherSessionLogs", fields: [teacherId], references: [id], onDelete: Cascade)

  behaviorTags SessionLogBehaviorTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([teacherId])
  @@index([tarih])
  @@map("session_logs")
}

// SessionLog <-> BehaviorTag cok-cok iliski tablosu
model SessionLogBehaviorTag {
  sessionLogId  String
  sessionLog    SessionLog  @relation(fields: [sessionLogId], references: [id], onDelete: Cascade)
  behaviorTagId String
  behaviorTag   BehaviorTag @relation(fields: [behaviorTagId], references: [id], onDelete: Cascade)

  @@id([sessionLogId, behaviorTagId])
  @@map("session_log_behavior_tags")
}

// KVKK: hassas veriye kim ne zaman eristi - denetim kaydi
model AuditLog {
  id        String   @id @default(cuid())
  // userId null olabilir: basarisiz giris denemesi olmayan/bilinmeyen bir
  // e-postayla yapilmis olabilir, ya da kullanici sonradan silinmis olabilir
  // (SetNull ile kayit korunur, denetim gecmisi asla silinmez).
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  eylem     String // ornek: "STUDENT_VIEW", "SESSION_LOG_CREATE", "LOGIN_SUCCESS"
  hedefTur  String // ornek: "Student", "SessionLog", "Auth"
  hedefId   String?
  detay     Json?
  ipAdresi  String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([hedefTur, hedefId])
  @@index([createdAt])
  @@map("audit_logs")
}
